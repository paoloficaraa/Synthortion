# ── Model gateway: Omniroute ────────────────────────────────────────────────
# Omniroute runs on the host at localhost:20128. From inside Docker Desktop
# containers the host machine is reachable at host.docker.internal, so the
# base URL below uses that instead of localhost.
#
# Claude Code appends /v1/messages to ANTHROPIC_BASE_URL (no /v1 here).
# Auth is sent as `Authorization: Bearer <token>`.
ANTHROPIC_BASE_URL=http://host.docker.internal:20128
ANTHROPIC_AUTH_TOKEN=
# Model Claude Code uses for background/quick tasks (Omniroute routing class).
ANTHROPIC_SMALL_FAST_MODEL=auto/fast

# ── GitHub ──────────────────────────────────────────────────────────────────
# Fine-grained PAT with permissions: Issues (Read and write), Metadata (Read)
# Create one at https://github.com/settings/personal-access-tokens/new
GH_TOKEN=
